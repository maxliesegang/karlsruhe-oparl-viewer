---
import SiteNavigation from "../components/SiteNavigation.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { NavigationSection } from "../shared/navigation";

interface Props {
  title?: string;
  pagefindIgnore?: boolean;
  navigationSection?: NavigationSection;
}

const { title, pagefindIgnore = false, navigationSection } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | GemeinderatsRadar` : "GemeinderatsRadar";
---

<!doctype html>
<html lang="de" data-pagefind-ignore={pagefindIgnore ? "all" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <SiteNavigation currentSection={navigationSection} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #fdcb00;
    --color-primary-hover: #f4a900;
    --color-link: #0066cc;
    --color-link-hover: #004999;
    --color-text: #333;
    --color-text-muted: #555;
    --color-border: #ddd;
    --color-bg-card: #f9f9f9;
    --shadow-card: 0 4px 6px rgba(0, 0, 0, 0.1);
    --radius: 8px;
    --font-family: Arial, sans-serif;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    background: #fff;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 3px solid #175f94;
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 2000;
    padding: 10px 14px;
    border-radius: var(--radius);
    background: #171717;
    color: #fff;
    font-family: var(--font-family);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .page-header {
    font-size: 2.5rem;
    color: var(--color-text);
    margin-bottom: 20px;
    font-family: var(--font-family);
    font-weight: bold;
    text-align: center;
  }

  .section-card {
    margin-top: 20px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .section-heading {
    font-size: 1.5rem;
    margin-bottom: 15px;
    font-weight: bold;
    color: var(--color-text);
  }
</style>

<style>
  main {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    padding: 20px;
    font-family: var(--font-family);
  }
</style>
