---
import type { ResolvedAuxiliaryFile } from "../shared/types";
import {
  formatDateLong,
  getOParlEntityId,
  normalizeOParlUrl,
} from "../shared/utils";

interface Props {
  auxiliaryFiles: ResolvedAuxiliaryFile[];
}

const { auxiliaryFiles } = Astro.props;
---

<section class="section-card">
  <h2 class="section-heading">Zusätzliche Dateien</h2>

  {
    auxiliaryFiles.length > 0 ? (
      <ul class="file-list">
        {auxiliaryFiles.map(({ file, content }) => {
          const extractedText = content?.extractedText;
          // Only text that the mirror actually publishes can be re-fetched, so
          // the placeholder stays a plain, non-lazy paragraph.
          const fileId = extractedText
            ? getOParlEntityId(content?.id ?? "")
            : undefined;
          const fileText = extractedText || "Kein Text verfügbar";

          return (
            <li class="file-item" data-id={file.id}>
              <div class="file-details">
                <a
                  href={normalizeOParlUrl(file.accessUrl)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="file-name"
                  aria-label={`Download ${file.name}`}
                >
                  <svg
                    class="download-icon"
                    width="24"
                    height="24"
                    fill="currentColor"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M12.707 11.293l-2 2a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L11 11.586V5a1 1 0 112 0v6.586l1.293-1.293a1 1 0 111.414 1.414z" />
                    <path d="M5 18a1 1 0 01-1-1v-1a1 1 0 112 0v1h10v-1a1 1 0 112 0v1a1 1 0 01-1 1H5z" />
                  </svg>
                  {file.name}
                </a>

                <div class="file-metadata">
                  <span>Erstellt: {formatDateLong(file.created)}</span>
                  <span>Zuletzt geändert: {formatDateLong(file.modified)}</span>
                </div>
              </div>

              {/* Extracted PDF text runs to thousands of words, so it stays
                  collapsed and scrolls within a fixed height once opened.

                  It is rendered here so Pagefind indexes it, but the
                  `pagefind-lean` integration empties `[data-file-text]` after
                  indexing and `file-text-loader.ts` re-fetches it on open. */}
              <details class="file-text-details" data-file-text-details>
                <summary class="file-text-toggle">
                  <span class="toggle-label toggle-show">
                    Extrahierten Text anzeigen
                  </span>
                  <span class="toggle-label toggle-hide">
                    Extrahierten Text ausblenden
                  </span>
                </summary>
                {/* Kept on one line: `.file-text` is `pre-wrap`, so any
                    surrounding whitespace would render. */}
                {/* prettier-ignore */}
                <p class="file-text" data-file-text data-file-id={fileId}>{fileText}</p>
              </details>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="no-files-msg">Keine zusätzlichen Dateien verfügbar.</p>
    )
  }
</section>

<style>
  .file-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .file-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 15px;
    background-color: #fff;
    transition: box-shadow 0.2s;
  }

  .file-item:hover {
    box-shadow: var(--shadow-card);
  }

  .file-name {
    font-weight: bold;
    font-size: 1.125rem;
    color: var(--color-link);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .file-name:hover {
    text-decoration: underline;
  }

  .download-icon {
    flex-shrink: 0;
  }

  .file-metadata {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
  }

  .file-text-details {
    margin-top: 10px;
  }

  .file-text-toggle {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    font-size: 0.875rem;
    color: #fff;
    background-color: var(--color-link);
    border-radius: 4px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s;
  }

  .file-text-toggle::-webkit-details-marker {
    display: none;
  }

  .file-text-toggle:hover {
    background-color: var(--color-link-hover);
  }

  .toggle-hide,
  .file-text-details[open] .toggle-show {
    display: none;
  }

  .file-text-details[open] .toggle-hide {
    display: inline;
  }

  .file-text {
    max-height: 26rem;
    overflow-y: auto;
    margin-top: 10px;
    padding: 12px;
    background-color: var(--color-bg-card);
    border-left: 3px solid var(--color-link);
    border-radius: 4px;
    font-size: 0.875rem;
    line-height: 1.5;
    /* The extraction preserves the PDF's line structure — collapsing it turns
       tables and lists into an unreadable run-on paragraph. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--color-text);
  }

  /* Status messages are single sentences, not extracted layout — the
     pre-wrap treatment that suits the text itself would misalign them. */
  .file-text[data-file-text-state="loading"],
  .file-text[data-file-text-state="error"] {
    white-space: normal;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .file-text[data-file-text-state="error"] {
    border-left-color: var(--color-text-muted);
  }
</style>

<script>
  import { initFileTextLoaders } from "../shared/file-text-loader";

  initFileTextLoaders();
</script>
