---
import {
  primaryNavigation,
  utilityNavigation,
  type NavigationItem,
  type NavigationSection,
} from "../shared/navigation";

interface Props {
  currentSection?: NavigationSection;
}

const { currentSection } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

function itemUrl(item: NavigationItem): string {
  return `${baseUrl}${item.path}`;
}
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="nav-container">
    <a class="brand" href={baseUrl} aria-label="GemeinderatsRadar – Startseite">
      <span class="brand-name">GemeinderatsRadar</span>
      <span class="brand-context">Karlsruhe</span>
    </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Menü öffnen"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-button
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <span>Menü</span>
    </button>

    <div class="site-menu" id="site-menu" data-site-menu>
      <nav class="primary-navigation" aria-label="Hauptnavigation">
        <p class="menu-group-label">Entdecken</p>
        <ul>
          {
            primaryNavigation.map((item) => {
              const isActive = item.section === currentSection;

              return (
                <li>
                  <a
                    href={itemUrl(item)}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <nav
        class="utility-navigation"
        aria-label="Suche und persönliche Inhalte"
      >
        <p class="menu-group-label">Werkzeuge</p>
        <ul>
          {
            utilityNavigation.map((item) => {
              const isActive = item.section === currentSection;

              return (
                <li>
                  <a
                    href={itemUrl(item)}
                    class="utility-link"
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.path === "" ? (
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        aria-hidden="true"
                      >
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-4-4" />
                      </svg>
                    ) : (
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        aria-hidden="true"
                      >
                        <path d="M6 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18l-6-4-6 4V4Z" />
                      </svg>
                    )}
                    <span>{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
<div class="menu-overlay" data-menu-overlay hidden></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    background: var(--color-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    font-family: var(--font-family);
  }

  .nav-container {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: 1400px;
    min-height: var(--site-header-height);
    margin: 0 auto;
    padding: 0 20px;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    flex-shrink: 0;
    color: #171717;
    line-height: 1.05;
    text-decoration: none;
  }

  .brand-name {
    font-size: 1.12rem;
    font-weight: 850;
    letter-spacing: -0.02em;
  }

  .brand-context {
    margin-top: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 13px;
    border-radius: 7px;
    color: #171717;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  nav a:hover {
    background: rgba(255, 255, 255, 0.48);
  }

  nav a[aria-current="page"] {
    background: #171717;
    color: #fff;
  }

  .utility-navigation ul {
    gap: 2px;
  }

  .utility-link {
    gap: 7px;
    font-size: 0.88rem;
  }

  .utility-link svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .menu-group-label,
  .menu-button {
    display: none;
  }

  .menu-overlay {
    display: none;
  }

  @media screen and (max-width: 920px) {
    .nav-container {
      justify-content: space-between;
      min-height: 62px;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 42px;
      padding: 0 11px;
      border: 1px solid rgba(0, 0, 0, 0.28);
      border-radius: 7px;
      background: transparent;
      color: #171717;
      font: inherit;
      font-size: 0.9rem;
      font-weight: 750;
      cursor: pointer;
    }

    .menu-button:hover {
      background: rgba(255, 255, 255, 0.48);
    }

    .menu-button svg {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 2;
    }

    .site-menu {
      position: fixed;
      top: 62px;
      right: 0;
      bottom: 0;
      display: block;
      width: min(360px, 88vw);
      padding: 20px;
      overflow-y: auto;
      background: #fff;
      box-shadow: -8px 0 24px rgba(0, 0, 0, 0.16);
      transform: translateX(105%);
      transition: transform 0.22s ease;
      visibility: hidden;
    }

    .site-menu.active {
      transform: translateX(0);
      visibility: visible;
    }

    .menu-group-label {
      display: block;
      margin: 4px 10px 8px;
      color: var(--color-text-muted);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    nav ul {
      display: grid;
      gap: 4px;
    }

    nav a {
      width: 100%;
      min-height: 48px;
      box-sizing: border-box;
      padding: 0 12px;
      font-size: 1rem;
    }

    nav a:hover {
      background: #f3f3f3;
    }

    .utility-navigation {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--color-border);
    }

    .utility-link {
      font-size: 1rem;
    }

    .menu-overlay {
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgba(0, 0, 0, 0.46);
    }

    .menu-overlay.active {
      display: block;
    }

    :global(body.menu-open) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu,
    nav a {
      transition: none;
    }
  }
</style>

<script>
  function initNavigation() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const button =
      header?.querySelector<HTMLButtonElement>("[data-menu-button]");
    const menu = header?.querySelector<HTMLElement>("[data-site-menu]");
    const overlay = document.querySelector<HTMLElement>("[data-menu-overlay]");
    const mobileQuery = window.matchMedia("(max-width: 920px)");

    if (!button || !menu || !overlay) return;

    function getFocusableElements(): HTMLElement[] {
      return Array.from(
        menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
      );
    }

    function setMenuState(isOpen: boolean, restoreFocus = false) {
      menu.classList.toggle("active", isOpen);
      overlay.classList.toggle("active", isOpen);
      overlay.hidden = !isOpen;
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute(
        "aria-label",
        isOpen ? "Menü schließen" : "Menü öffnen",
      );
      document.body.classList.toggle("menu-open", isOpen);

      if (isOpen) {
        getFocusableElements()[0]?.focus();
      } else if (restoreFocus) {
        button.focus();
      }
    }

    button.addEventListener("click", () => {
      const isOpen = menu.classList.contains("active");
      setMenuState(!isOpen, isOpen);
    });

    overlay.addEventListener("click", () => setMenuState(false, true));

    menu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement && mobileQuery.matches) {
        setMenuState(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (!menu.classList.contains("active")) return;

      if (event.key === "Escape") {
        event.preventDefault();
        setMenuState(false, true);
        return;
      }

      if (event.key !== "Tab") return;

      const focusable = getFocusableElements();
      const first = focusable[0];
      const last = focusable.at(-1);

      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    mobileQuery.addEventListener("change", () => setMenuState(false));
  }

  initNavigation();
</script>
