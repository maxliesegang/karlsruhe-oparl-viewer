---
import { buildMeetingCalendarUrl } from "../shared/utils";
import FeedSubscriptionLink from "./FeedSubscriptionLink.astro";

interface CommitteeFeedLink {
  name: string;
  url: string;
}

interface Props {
  meetingId: string;
  committeeFeeds: CommitteeFeedLink[];
}

const { meetingId, committeeFeeds } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<div class="meeting-actions">
  <a
    class="calendar-download"
    href={buildMeetingCalendarUrl(baseUrl, meetingId)}
    download={`sitzung-${meetingId}.ics`}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
      <path d="M16 3v4M8 3v4M3 10h18"></path>
    </svg>
    Einzeltermin herunterladen (.ics)
  </a>
  {
    committeeFeeds.map((feed) => (
      <FeedSubscriptionLink
        href={feed.url}
        label={`Aktualisierungen für ${feed.name} abonnieren`}
      />
    ))
  }
</div>

<style>
  .meeting-actions {
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  .calendar-download {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .calendar-download:hover {
    background: var(--color-primary-hover);
  }

  .calendar-download svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }
</style>
