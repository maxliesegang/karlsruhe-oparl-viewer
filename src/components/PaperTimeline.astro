---
import type { Paper, ResolvedConsultation } from "../shared/types";
import {
  getConsultationResult,
  isUpcomingMeeting,
  orderConsultations,
} from "../shared/paper-status";
import {
  buildMeetingUrl,
  formatAgendaItemLabel,
  formatDateTime,
  formatMeetingSlot,
} from "../shared/utils";

interface Props {
  paper: Paper;
  consultations: ResolvedConsultation[];
}

const { paper, consultations } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const now = Date.now();

const orderedConsultations = orderConsultations(consultations);
---

<section class="section-card paper-timeline" aria-labelledby="paper-timeline">
  <h2 class="section-heading" id="paper-timeline">Verlauf</h2>

  <ol class="timeline-list">
    <li class="timeline-item completed">
      <span class="timeline-marker" aria-hidden="true"></span>
      <div>
        <strong>Vorlage veröffentlicht</strong>
        <p>{formatDateTime(paper.created)} Uhr</p>
      </div>
    </li>
    {
      orderedConsultations.map((resolved) => {
        const { consultation, meeting, agendaItem } = resolved;
        const meetingIsUpcoming = isUpcomingMeeting(meeting, now);
        const result = getConsultationResult(resolved);
        const title = result ? "Entscheidung" : "Beratung";
        const meetingUrl = buildMeetingUrl(baseUrl, meeting);
        // `role` and `result` are frequently the same word ("Kenntnisnahme"),
        // and the result line below is the one that carries it.
        const role = consultation.role?.trim();
        const meetingSlot = formatMeetingSlot(
          meeting?.start,
          formatAgendaItemLabel(agendaItem?.number),
          role && role !== result ? role : "",
        );

        return (
          <li class:list={["timeline-item", !meetingIsUpcoming && "completed"]}>
            <span class="timeline-marker" aria-hidden="true" />
            <div>
              <strong>
                {title}
                {meetingIsUpcoming && <span class="timeline-tag">Geplant</span>}
              </strong>
              {/* Committee and date share a wrapping row — on the detail
                  page's wide main column they fit on one line, and they still
                  break cleanly on narrow screens. */}
              {meeting ? (
                <p class="timeline-meta">
                  {meetingUrl ? (
                    <a href={meetingUrl}>{meeting.name}</a>
                  ) : (
                    <span>{meeting.name}</span>
                  )}
                  <span>{meetingSlot}</span>
                </p>
              ) : (
                <p>Termin nicht verfügbar</p>
              )}
              {result && <p class="timeline-result">Ergebnis: {result}</p>}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .section-heading {
    margin-top: 0;
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    padding-bottom: 14px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 15px;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-marker {
    width: 12px;
    height: 12px;
    margin-top: 3px;
    border: 2px solid var(--color-primary-hover);
    border-radius: 50%;
    background: #fff;
    z-index: 1;
  }

  .timeline-item.completed .timeline-marker {
    background: var(--color-primary);
  }

  /* Everything after the last completed step is still a plan — the dashed
     connector says so without needing a second legend. */
  .timeline-item:not(.completed):not(:last-child)::before {
    background: repeating-linear-gradient(
      to bottom,
      var(--color-border) 0 4px,
      transparent 4px 8px
    );
  }

  .timeline-tag {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #e6eefa;
    color: #14508f;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    vertical-align: 1px;
  }

  .timeline-item p {
    margin: 2px 0 0;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
  }

  .timeline-item a {
    color: var(--color-link);
    text-decoration: none;
  }

  .timeline-item a:hover {
    text-decoration: underline;
  }

  .timeline-result {
    color: var(--color-text) !important;
    font-weight: 700;
  }
</style>
