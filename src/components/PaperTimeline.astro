---
import type { Paper, ResolvedConsultation } from "../shared/types";
import { isUpcomingMeeting, orderConsultations } from "../shared/paper-status";
import {
  buildMeetingDetailUrl,
  formatDateTime,
  getOParlEntityId,
} from "../shared/utils";

interface Props {
  paper: Paper;
  consultations: ResolvedConsultation[];
}

const { paper, consultations } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const now = Date.now();

const orderedConsultations = orderConsultations(consultations);
---

<section class="section-card paper-timeline" aria-labelledby="paper-timeline">
  <h2 class="section-heading" id="paper-timeline">Verlauf</h2>

  <ol class="timeline-list">
    <li class="timeline-item completed">
      <span class="timeline-marker" aria-hidden="true"></span>
      <div>
        <strong>Vorlage veröffentlicht</strong>
        <p>{formatDateTime(paper.created)} Uhr</p>
      </div>
    </li>
    {
      orderedConsultations.map(({ consultation, meeting, agendaItem }) => {
        const meetingIsUpcoming = isUpcomingMeeting(meeting, now);
        const result = agendaItem?.result?.trim();
        const title = result
          ? "Entscheidung"
          : meetingIsUpcoming
            ? "Geplante Beratung"
            : "Beratung";
        const meetingId = meeting ? getOParlEntityId(meeting.id) : "";

        return (
          <li class:list={["timeline-item", !meetingIsUpcoming && "completed"]}>
            <span class="timeline-marker" aria-hidden="true" />
            <div>
              <strong>{title}</strong>
              {meeting ? (
                <>
                  <p>
                    <a href={buildMeetingDetailUrl(baseUrl, meetingId)}>
                      {meeting.name}
                    </a>
                  </p>
                  <p>
                    {formatDateTime(meeting.start)} Uhr
                    {agendaItem?.number ? ` · TOP ${agendaItem.number}` : ""}
                    {consultation.role ? ` · ${consultation.role}` : ""}
                  </p>
                </>
              ) : (
                <p>Termin nicht verfügbar</p>
              )}
              {result && <p class="timeline-result">Ergebnis: {result}</p>}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .section-heading {
    margin-top: 0;
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    padding-bottom: 20px;
  }

  .timeline-item:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 15px;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-marker {
    width: 12px;
    height: 12px;
    margin-top: 3px;
    border: 2px solid var(--color-primary-hover);
    border-radius: 50%;
    background: #fff;
    z-index: 1;
  }

  .timeline-item.completed .timeline-marker {
    background: var(--color-primary);
  }

  .timeline-item p {
    margin: 4px 0 0;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .timeline-item a {
    color: var(--color-link);
    text-decoration: none;
  }

  .timeline-item a:hover {
    text-decoration: underline;
  }

  .timeline-result {
    color: var(--color-text) !important;
    font-weight: 700;
  }
</style>
