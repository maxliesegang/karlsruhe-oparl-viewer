---
import type { Organization, Paper } from "../shared/types";
import { formatDateShort } from "../shared/utils";

interface Props {
  paper: Paper;
  organizations: Organization[];
}

const { paper, organizations } = Astro.props;

const pagefindSortAtt = `date:${new Date(paper.date).toISOString()}`;
const pagefindModifiedSortAtt = `modified:${new Date(paper.modified).toISOString()}`;

/** Search result cards read these as Pagefind meta — keep the names in sync
 * with `search-panel-controller.ts`. */
const organizationNames =
  organizations
    ?.map((item) => item?.name)
    .filter(Boolean)
    .join(", ") ?? "";
const districtNames = paper.stadtteile?.join(", ") ?? "";
---

<section class="section-card">
  <table>
    <tbody>
      <tr>
        <th>Vorlage:</th>
        <td data-pagefind-meta="paper-reference">{paper.reference}</td>
      </tr>
      <tr>
        <th>Art:</th>
        <td data-pagefind-meta={paper.paperType ? "paper-type" : undefined}
          >{paper.paperType}</td
        >
      </tr>
      <tr>
        <th>Datum:</th>
        <td data-pagefind-sort={pagefindSortAtt}>
          <time datetime={paper.date} data-pagefind-meta="paper-date[datetime]"
            >{formatDateShort(paper.date)}</time
          >
        </td>
      </tr>
      <tr>
        <th>Letzte Änderung:</th>
        <td>
          <time
            datetime={paper.modified}
            data-pagefind-meta="paper-modified[datetime]"
            data-pagefind-sort={pagefindModifiedSortAtt}
            >{formatDateShort(paper.modified)}</time
          >
          {/* Literal meta value — keeps the raw timestamp out of excerpts. */}
          <span data-pagefind-meta={`paper-created:${paper.created}`}></span>
        </td>
      </tr>
      <tr>
        <th>Unter Leitung von:</th>
        <td
          data-pagefind-meta={organizationNames
            ? "paper-organizations"
            : undefined}>{organizationNames || "Keine Angaben"}</td
        >
      </tr>
      <tr>
        <th>Erwähnte Stadtteile:</th>
        <td data-pagefind-meta={districtNames ? "paper-districts" : undefined}
          >{districtNames || "Keine Angaben"}</td
        >
      </tr>
    </tbody>
  </table>
</section>

<style>
  table th {
    text-align: right;
    padding-right: 10px;
  }
</style>
