---
import type { Organization, Paper } from "../shared/types";
import { formatDateShort } from "../shared/utils";

interface Props {
  paper: Paper;
  organizations: Organization[];
}

const { paper, organizations } = Astro.props;

const pagefindSortAtt = `date:${new Date(paper.date).toISOString()}`;
const pagefindModifiedSortAtt = `modified:${new Date(paper.modified).toISOString()}`;
---

<section class="section-card">
  <table>
    <tbody>
      <tr>
        <th>Vorlage:</th>
        <td>{paper.reference}</td>
      </tr>
      <tr>
        <th>Art:</th>
        <td>{paper.paperType}</td>
      </tr>
      <tr>
        <th>Datum:</th>
        <td data-pagefind-sort={pagefindSortAtt}>
          <time datetime={paper.date}>{formatDateShort(paper.date)}</time>
        </td>
      </tr>
      <tr>
        <th>Letzte Änderung:</th>
        <td>
          <time
            datetime={paper.modified}
            data-pagefind-meta="paper-modified[datetime]"
            data-pagefind-sort={pagefindModifiedSortAtt}
            >{formatDateShort(paper.modified)}</time
          >
          <time
            datetime={paper.created}
            data-pagefind-meta="paper-created[datetime]"
            hidden>{paper.created}</time
          >
        </td>
      </tr>
      <tr>
        <th>Unter Leitung von:</th>
        <td
          >{
            organizations?.map((item) => item?.name).join(", ") ||
              "Keine Angaben"
          }</td
        >
      </tr>
      <tr>
        <th>Erwähnte Stadtteile:</th>
        <td>{paper.stadtteile?.join(", ") || "Keine Angaben"}</td>
      </tr>
    </tbody>
  </table>
</section>

<style>
  table th {
    text-align: right;
    padding-right: 10px;
  }
</style>
