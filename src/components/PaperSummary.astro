---
import type { PaperSummary } from "../shared/types";
import { formatDateLong } from "../shared/utils";

interface Props {
  summary: PaperSummary | undefined;
}

const { summary } = Astro.props;
const keyPoints = summary?.keyPoints?.filter(Boolean) ?? [];

/* Model and prompt version are what makes a summary reproducible, so they go on
   the record — folded into the footnote's `title` rather than spelled out, since
   they mean nothing to most readers. */
const provenance = [summary?.model, summary?.promptVersion, summary?.provider]
  .filter(Boolean)
  .join(" · ");
---

{
  summary && (
    <section class="section-card summary-card" aria-labelledby="paper-summary">
      <div class="summary-header">
        <h2 class="section-heading" id="paper-summary">
          Zusammenfassung
        </h2>
        <span class="summary-badge" title={provenance || undefined}>
          KI-generiert
        </span>
      </div>

      {/* Summaries are a few sentences by design (~400 characters), so they are
          shown in full — collapsing them would cost a click and save no space. */}
      <p class="summary-text">{summary.summary}</p>

      {keyPoints.length > 0 && (
        <>
          <h3 class="summary-points-heading">Kernpunkte</h3>
          {/* Key points run to two or three lines each, so they are numbered
              rows rather than bullets — at that length a plain list reads as
              one block of prose and stops being scannable. */}
          <ol class="summary-points">
            {keyPoints.map((keyPoint, index) => (
              <li>
                <span class="point-number" aria-hidden="true">
                  {index + 1}
                </span>
                <span class="point-text">{keyPoint}</span>
              </li>
            ))}
          </ol>
        </>
      )}

      <p class="summary-note" data-pagefind-ignore>
        <span class="summary-note-icon" aria-hidden="true">
          ⚠
        </span>
        <span>
          Automatisch erzeugt am {formatDateLong(summary.generatedAt)}. Kann
          Fehler enthalten — maßgeblich ist der Originaltext der Vorlage.
        </span>
      </p>
    </section>
  )
}

<style>
  .summary-card {
    /* The lead element of the page: same card shell as its siblings, marked out
       by the brand accent rather than by a different background. */
    border-left: 4px solid var(--color-primary);
  }

  .summary-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .summary-header .section-heading {
    margin: 0;
  }

  .summary-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 9px;
    cursor: help;
  }

  .summary-text {
    max-width: 80ch;
    margin: 10px 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .summary-points-heading {
    margin: 16px 0 8px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  /* One point per row at every width: the points are two or three lines each
     and read in order, so a second column would break the numbered sequence
     into a zig-zag and leave ragged row heights. */
  .summary-points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 8px;
  }

  .summary-points li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    padding: 9px 11px;
    border-radius: var(--radius);
    background: var(--color-bg-card);
    line-height: 1.5;
  }

  .point-number {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #333;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .summary-note {
    display: flex;
    gap: 8px;
    margin: 14px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .summary-note-icon {
    flex-shrink: 0;
  }
</style>
