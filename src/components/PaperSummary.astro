---
import type { AuxiliaryFile, PaperSummary } from "../shared/types";
import { buildKeyPointSourceLinks } from "../shared/paper-presentation";
import { formatDateLong, normalizeOParlUrl } from "../shared/utils";

interface Props {
  summary: PaperSummary | undefined;
  /** The paper's attachments, to resolve each key point's source file. */
  files: AuxiliaryFile[];
}

const { summary, files } = Astro.props;
/* Sources are index-aligned with the stored key points, so pair them before
   dropping empty points rather than after. */
const sourceLinks = buildKeyPointSourceLinks(summary?.keyPointSources, files);
const keyPoints = (summary?.keyPoints ?? [])
  .map((text, index) => ({ text, source: sourceLinks[index] }))
  .filter(({ text }) => Boolean(text));

/* Model and prompt version are what makes a summary reproducible, so they go on
   the record — folded into the footnote's `title` rather than spelled out, since
   they mean nothing to most readers. */
const provenance = [summary?.model, summary?.promptVersion, summary?.provider]
  .filter(Boolean)
  .join(" · ");
---

{summary && (
  <section class="section-card summary-card" aria-labelledby="paper-summary">
    <div class="summary-header">
      <h2 class="section-heading" id="paper-summary">
        Zusammenfassung
      </h2>
      <span class="summary-badge" title={provenance || undefined}>
        KI-generiert
      </span>
    </div>

    {/* Summaries are a few sentences by design (~400 characters), so they are
          shown in full — collapsing them would cost a click and save no space. */}
    <p class="summary-text" data-pagefind-weight="2">
      {summary.summary}
    </p>

    {keyPoints.length > 0 && (
      <>
        <h3 class="summary-points-heading">Kernpunkte</h3>
        {/* Key points run to two or three lines each, so they are numbered
              rows rather than bullets — at that length a plain list reads as
              one block of prose and stops being scannable. */}
        <ol class="summary-points">
          {keyPoints.map(({ text, source }, index) => (
            <li>
              <span class="point-number" aria-hidden="true">
                {index + 1}
              </span>
              <span class="point-body">
                <span class="point-text" data-pagefind-weight="2">
                  {text}
                </span>
                {/* "Quelle" highlights the quoted passage in the attachment's
                      text below (see `showFilePassage`), which works for the
                      many archive texts without page numbers; the PDF page is
                      a second link when known. The quote is stored once, as a
                      data attribute — no tooltip copy, since it would double
                      the bytes on every summarized paper. Without JS the link
                      lands on the attachment list. */}
                {source && (
                  <span class="point-source" data-pagefind-ignore>
                    Quelle:{" "}
                    <a
                      href="#paper-files"
                      data-source-file={source.file}
                      data-source-quote={source.quote}
                    >
                      {source.name}
                    </a>
                    {source.pageHref && (
                      <>
                        {" · "}
                        <a
                          href={normalizeOParlUrl(source.pageHref)}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${source.name} als PDF auf Seite ${source.page} öffnen`}
                        >
                          PDF S.&nbsp;{source.page}
                        </a>
                      </>
                    )}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ol>
      </>
    )}

    <p class="summary-note" data-pagefind-ignore>
      <span class="summary-note-icon" aria-hidden="true">
        ⚠︎
      </span>
      <span>
        Automatisch erzeugt am {formatDateLong(summary.generatedAt)}. Kann
        Fehler enthalten — maßgeblich ist der Originaltext der Vorlage.
      </span>
    </p>
  </section>
)}

<style>
  .summary-card {
    /* The lead element of the page: same card shell as its siblings, marked out
       by the brand accent rather than by a different background. */
    border-left: 4px solid var(--color-primary);
  }

  .summary-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .summary-header .section-heading {
    margin: 0;
  }

  .summary-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 9px;
    cursor: help;
  }

  .summary-text {
    max-width: 80ch;
    margin: 10px 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .summary-points-heading {
    margin: 16px 0 8px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  /* One point per row at every width: the points are two or three lines each
     and read in order, so a second column would break the numbered sequence
     into a zig-zag and leave ragged row heights. */
  .summary-points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 8px;
  }

  .summary-points li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    padding: 9px 11px;
    border-radius: var(--radius);
    background: var(--color-bg-card);
    line-height: 1.5;
  }

  .point-number {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #333;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .point-body {
    display: grid;
    gap: 3px;
  }

  .point-source {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .point-source a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
  }

  .point-source a:hover,
  .point-source a:focus-visible {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .summary-note {
    display: flex;
    gap: 8px;
    margin: 14px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .summary-note-icon {
    flex-shrink: 0;
  }
</style>

<script>
  import { showFilePassage } from "../shared/file-text-loader";

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "a[data-source-file]",
  )) {
    link.addEventListener("click", (event) => {
      // Modified clicks keep the browser's own behaviour.
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      event.preventDefault();
      const { sourceFile = "", sourceQuote = "" } = link.dataset;
      void showFilePassage(sourceFile, sourceQuote).then((shown) => {
        // No card for this file: behave like the plain anchor.
        if (!shown) location.hash = "paper-files";
      });
    });
  }
</script>
