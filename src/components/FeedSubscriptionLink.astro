---
interface Props {
  href: string;
  label?: string;
}

const { href, label = "Aktualisierungen abonnieren" } = Astro.props;
---

<a
  class="feed-subscription-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  type="application/atom+xml"
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="5" cy="19" r="2"></circle>
    <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
  </svg>
  <span>{label}</span>
  <span class="visually-hidden"> (öffnet in neuem Tab)</span>
</a>

<style>
  .feed-subscription-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-link);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .feed-subscription-link:hover {
    background: #fafafa;
    text-decoration: underline;
  }

  svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }
</style>
