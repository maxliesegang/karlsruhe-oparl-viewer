---
interface Props {
  class?: string;
  /**
   * `narrow` keeps long-form pages at a readable measure; `search` is the
   * single column of a search box above its result list.
   */
  width?: "wide" | "narrow" | "search";
}

const { class: className, width = "wide" } = Astro.props;
---

<div class:list={["page-container", `width-${width}`, className]}>
  <slot />
</div>

<style>
  .page-container {
    margin: 0 auto;
  }

  .width-wide {
    max-width: 1400px;
  }

  .width-narrow {
    max-width: 1120px;
  }

  .width-search {
    max-width: 900px;
  }
</style>
