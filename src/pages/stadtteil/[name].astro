---
import Layout from "../../layouts/Layout.astro";
import PaperListPage from "../../components/PaperListPage.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StadtteilHint from "../../components/StadtteilHint.astro";
import FeedSubscriptionLink from "../../components/FeedSubscriptionLink.astro";
import {
  getAvailableDistricts,
  loadPapers,
  loadSyndicationFeedCatalog,
} from "../../shared/data";
import { loadPaperFilterModel } from "../../shared/paper-filters";
import { slugify } from "../../shared/utils";

export async function getStaticPaths() {
  const districtNames = await getAvailableDistricts();
  return districtNames.map((districtName) => ({
    params: { name: slugify(districtName) },
    props: { districtName },
  }));
}

const { districtName } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const allPapers = await loadPapers();
const feedCatalog = await loadSyndicationFeedCatalog();
const districtPapers = allPapers.filter((paper) =>
  paper.stadtteile.includes(districtName),
);
const districtFeed = feedCatalog.districtFeedByName.get(districtName);

const { papers, valuesById, options } =
  await loadPaperFilterModel(districtPapers);
---

<Layout
  title={districtName}
  description={`Vorlagen des Karlsruher Gemeinderats mit Bezug zum Stadtteil ${districtName} – ${papers.length} Einträge, nach Jahr und Status filterbar.`}
  navigationSection="districts"
>
  <PaperListPage
    title={districtName}
    papers={papers}
    filterValuesById={valuesById}
    filterOptions={options}
  >
    <div slot="intro">
      <Breadcrumbs
        items={[
          { label: "Stadtteile", href: `${baseUrl}stadtteile` },
          { label: districtName },
        ]}
      />
      <div class="district-actions" data-pagefind-ignore>
        <p class="subtitle">{papers.length} Vorlagen</p>
        {
          districtFeed && (
            <FeedSubscriptionLink
              href={districtFeed.url}
              label={`Aktualisierungen für ${districtName} abonnieren`}
            />
          )
        }
      </div>
    </div>
    <StadtteilHint slot="intro" />
  </PaperListPage>
</Layout>

<style>
  .district-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }

  .subtitle {
    margin: 0;
  }
</style>
