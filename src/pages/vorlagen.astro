---
import Layout from "../layouts/Layout.astro";
import PaperListPage from "../components/PaperListPage.astro";
import { loadPaperFilterModel } from "../shared/paper-filters";

const { papers, valuesById, options } = await loadPaperFilterModel();
---

<Layout title="Vorlagen" navigationSection="papers">
  <PaperListPage
    title="Vorlagen"
    papers={papers}
    filterValuesById={valuesById}
    filterOptions={options}
  />
</Layout>
