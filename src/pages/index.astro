---
import { getUpcomingMeetings } from "../shared/data";
import { buildMeetingUrl } from "../shared/utils";
import Layout from "../layouts/Layout.astro";
import PageContainer from "../components/PageContainer.astro";
import SearchPanel from "../components/SearchPanel.astro";
import { resolvePagefindAvailability } from "../shared/pagefind-server";

const pagefind = resolvePagefindAvailability(import.meta.env.SKIP_PAGEFIND, {
  isDev: import.meta.env.DEV,
});
// A few sessions ahead, so the page stays correct between builds: the inline
// script below shows the first that has not yet ended.
const nextMeetings = (await getUpcomingMeetings())
  .filter((meeting) =>
    meeting.organization?.includes(
      "https://web2.karlsruhe.de/ris/oparl/bodies/0001/organizations/gr/32130",
    ),
  )
  .slice(0, 3);
const formatMeetingStart = new Intl.DateTimeFormat("de-DE", {
  timeZone: "Europe/Berlin",
  weekday: "short",
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});
const baseUrl = import.meta.env.BASE_URL;
const siteUrl = Astro.site ? new URL(baseUrl, Astro.site).href : undefined;
const structuredData = siteUrl
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "GemeinderatsRadar",
      alternateName: "GemeinderatsRadar Karlsruhe",
      url: siteUrl,
      inLanguage: "de",
      description:
        "Vorlagen, Sitzungen und Tagesordnungspunkte des Karlsruher Gemeinderats – durchsuchbar, verlinkt und täglich aktualisiert.",
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${siteUrl}?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    }
  : undefined;
---

<Layout
  description="Vorlagen, Sitzungen und Tagesordnungspunkte des Karlsruher Gemeinderats – durchsuchbar, verlinkt und täglich aktualisiert."
  structuredData={structuredData}
  navigationSection="search"
>
  <PageContainer class="search-page" width="search">
    <header class="search-intro">
      <div class="search-heading">
        <h1 class="page-header">Vorlagen durchsuchen</h1>
        <p class="search-tagline">
          Themen, Anträge und Entscheidungen aus Karlsruhe.
        </p>
      </div>
      {nextMeetings.map((meeting, index) => (
        <a
          class="next-meeting"
          href={buildMeetingUrl(baseUrl, meeting)}
          data-next-meeting
          data-ends={meeting.end || meeting.start}
          hidden={index > 0}
        >
          <span class="meeting-label">Nächster Gemeinderat:</span>{" "}
          <time datetime={meeting.start}>
            {formatMeetingStart.format(new Date(meeting.start))} Uhr
          </time>{" "}
          <span aria-hidden="true">→</span>
        </a>
      ))}
      <script is:inline>
        (() => {
          const links = document.querySelectorAll("[data-next-meeting]");
          const next = [...links].find(
            (link) => Date.parse(link.dataset.ends) > Date.now(),
          );
          for (const link of links) link.hidden = link !== next;
        })();
      </script>
    </header>
    {pagefind.enabled ? (
      <SearchPanel snapshot />
    ) : (
      <p class="empty-state" role="status">
        {pagefind.disabledMessage}
      </p>
    )}
  </PageContainer>
</Layout>

<style>
  /* A single quiet line: the next session is a pointer, not a home-page module. */
  .next-meeting {
    color: var(--color-link);
    font-size: 0.84rem;
    line-height: 1.45;
    text-decoration: none;
  }
  .next-meeting:hover time {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .meeting-label {
    color: var(--color-text-muted);
  }
  .next-meeting time {
    font-weight: 600;
    white-space: nowrap;
  }
  .search-page {
    grid-template-columns: minmax(0, 1fr);
    display: grid;
    gap: 14px;
  }

  .search-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 6px 24px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .search-heading {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .search-intro .page-header {
    margin: 0;
    text-align: left;
    font-size: clamp(1.4rem, 1.2rem + 0.7vw, 1.8rem);
  }

  .search-tagline {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.45;
    text-wrap: balance;
  }
</style>
