---
import { calendarDate } from "../../shared/search-state";
import { BULK_MODIFIED_DATE } from "../../shared/constants";
import { loadSearchIndex } from "../../shared/search-index";
import Layout from "../../layouts/Layout.astro";
import PageContainer from "../../components/PageContainer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PaperHeader from "../../components/PaperHeader.astro";
import PaperFacts from "../../components/PaperFacts.astro";
import PaperSummary from "../../components/PaperSummary.astro";
import PaperTimeline from "../../components/PaperTimeline.astro";
import PaperHistory from "../../components/PaperHistory.astro";
import RelatedPapers from "../../components/RelatedPapers.astro";
import AuxiliaryFiles from "../../components/AuxiliaryFiles.astro";
import {
  resolveOrganizations,
  resolvePaperSubmitters,
  resolveConsultations,
  resolveAuxiliaryFiles,
  resolveRelatedPapers,
  resolvePaperSummary,
  isPaperSubmittedByAfd,
} from "../../shared/data";
import { derivePaperStatus } from "../../shared/paper-status";
import { getPaperDetailStaticPaths } from "../../shared/paper-detail-paths";
import { buildPapersUrl } from "../../shared/utils";
import { buildPaperDescription } from "../../shared/seo";
import type { Paper } from "../../shared/types";

export async function getStaticPaths() {
  return getPaperDetailStaticPaths();
}

interface Props {
  paper: Paper;
}

const { paper } = Astro.props;

const [
  organizations,
  submitters,
  consultations,
  auxiliaryFiles,
  relatedPapers,
  summary,
  submittedByAfd,
] = await Promise.all([
  resolveOrganizations(paper),
  resolvePaperSubmitters(paper),
  resolveConsultations(paper),
  resolveAuxiliaryFiles(paper),
  resolveRelatedPapers(paper),
  resolvePaperSummary(paper),
  isPaperSubmittedByAfd(paper),
]);

const searchRecord = (await loadSearchIndex()).records.get(paper.id)!;
const baseUrl = import.meta.env.BASE_URL;
const status = derivePaperStatus(consultations);
const year = calendarDate(paper.date).slice(0, 4);
const metaDescription = buildPaperDescription({
  reference: paper.reference,
  name: paper.name,
  paperType: paper.paperType,
  date: paper.date,
  summary: summary?.summary,
});
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LegislativeDocument",
  name: paper.name,
  identifier: paper.reference,
  ...(paper.paperType ? { genre: paper.paperType } : {}),
  ...(paper.date ? { datePublished: paper.date } : {}),
  ...(paper.modified ? { dateModified: paper.modified } : {}),
  inLanguage: "de",
  legislationJurisdiction: "Stadt Karlsruhe",
  ...(submitters.length > 0
    ? {
        creator: submitters.map(({ name }) => ({
          "@type": "Organization",
          name,
        })),
      }
    : {}),
  ...(summary?.summary ? { abstract: summary.summary } : {}),
};
---

<Layout
  title={`${paper.reference} – ${paper.name}`}
  description={metaDescription}
  structuredData={structuredData}
  navigationSection="search"
  siteHintScan
  siteHintForce={submittedByAfd}
>
  <PageContainer>
    <Breadcrumbs
      items={[
        { label: "Vorlagen", href: buildPapersUrl(baseUrl) },
        ...(year ? [{ label: year, href: buildPapersUrl(baseUrl, year) }] : []),
        { label: paper.reference },
      ]}
    />

    <div data-pagefind-ignore>
      {[
        paper.created,
        ...(paper.modified.startsWith(BULK_MODIFIED_DATE)
          ? []
          : [paper.modified]),
      ]
        .map((value) =>
          Number.isFinite(Date.parse(value))
            ? new Date(value).toISOString().slice(0, 10)
            : "",
        )
        .filter(Boolean)
        .map((day) => (
          <span data-pagefind-filter={`freshness:${day}`} />
        ))}
      <span data-pagefind-sort={`changed:${searchRecord.rank}`} />
      <span data-pagefind-filter={`reference:${searchRecord.reference}`} />
      {searchRecord.date && (
        <span data-pagefind-filter={`day:${searchRecord.date}`} />
      )}
      {(["district", "faction", "committee"] as const).map((field) =>
        searchRecord[field].map((value) => (
          <span data-pagefind-filter={`${field}:${value}`} />
        )),
      )}
      {searchRecord.type && (
        <span data-pagefind-filter={`type:${searchRecord.type}`} />
      )}
    </div>
    <PaperHeader paper={paper} status={status} />

    {/* Two columns from 60rem up: the narrative (summary, course, documents)
        beside the reference data. Below that they stack in source order, which
        is why the header carries the facts a reader needs first. */}
    <div class="detail-layout">
      <div class="detail-main">
        <PaperSummary summary={summary} files={paper.auxiliaryFile ?? []} />
        <PaperTimeline paper={paper} consultations={consultations} />
        <AuxiliaryFiles auxiliaryFiles={auxiliaryFiles} />
        <PaperHistory
          paperId={paper.id}
          files={paper.auxiliaryFile ?? []}
          organizations={organizations}
          consultations={consultations}
          relatedPapers={[
            ...relatedPapers.superordinated,
            ...relatedPapers.subordinated,
          ]}
        />
      </div>

      <aside class="detail-side" aria-label="Weitere Angaben zur Vorlage">
        <PaperFacts
          paper={paper}
          organizations={organizations}
          submitters={submitters}
        />
        <RelatedPapers {...relatedPapers} />
      </aside>
    </div>
  </PageContainer>
</Layout>

<style>
  /* Section spacing comes from the global `.section-card` top margin, so the
     columns stay plain blocks rather than gapped flex containers. */
  .detail-layout {
    display: grid;
    align-items: start;
    column-gap: 24px;
  }

  @media (min-width: 60rem) {
    .detail-layout {
      grid-template-columns: minmax(0, 1fr) 21rem;
      column-gap: 32px;
    }

    /* The main column is long — extracted PDF text alone runs several screens —
       so the reference data follows along instead of scrolling out of reach.
       Only sticks when the sidebar is genuinely shorter than the viewport;
       `max-height` keeps a tall sidebar scrollable rather than clipped. */
    .detail-side {
      position: sticky;
      top: calc(var(--site-header-height) + 16px);
      max-height: calc(100vh - var(--site-header-height) - 36px);
      overflow-y: auto;
    }
  }

  /* On wide screens the extra room goes to the sidebar too — the main column
     alone would only stretch its tables, since its prose is capped at 68ch. */
  @media (min-width: 85rem) {
    .detail-layout {
      grid-template-columns: minmax(0, 1fr) 25rem;
    }
  }

  .detail-main,
  .detail-side {
    min-width: 0;
  }

  /* Sidebar cards are supporting material — quieter headings than the main
     column, and short enough to stay on one line in a 21rem column. */
  .detail-side :global(.section-heading) {
    font-size: 1.2rem;
  }
</style>
