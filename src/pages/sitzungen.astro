---
import Layout from "../layouts/Layout.astro";
import PageContainer from "../components/PageContainer.astro";
import MeetingFilters from "../components/MeetingFilters.astro";
import MeetingList from "../components/MeetingList.astro";
import MeetingViewTabs from "../components/MeetingViewTabs.astro";
import {
  getPastMeetings,
  getUpcomingMeetings,
  loadOrganizations,
} from "../shared/data";
import { buildMeetingFilterModel } from "../shared/meeting-filters";
import { buildMeetingArchiveUrl } from "../shared/meeting-archive";

const [meetings, pastMeetings, organizationsById] = await Promise.all([
  getUpcomingMeetings(),
  getPastMeetings(),
  loadOrganizations(),
]);
const { valuesById: meetingFilterValuesById, options: meetingFilterOptions } =
  buildMeetingFilterModel(meetings, organizationsById);
const baseUrl = import.meta.env.BASE_URL;
const archiveUrl = buildMeetingArchiveUrl(baseUrl);
---

<Layout
  title="Kommende Sitzungen"
  description="Kommende Sitzungen des Karlsruher Gemeinderats und seiner Gremien mit Tagesordnung und Unterlagen."
  pagefindIgnore
  navigationSection="meetings"
>
  <PageContainer class="meetings-page">
    <h1 class="page-header">Sitzungen</h1>
    <MeetingViewTabs current="upcoming" />
    <div class="page-intro" data-pagefind-ignore>
      <p>
        Öffentliche Termine und Tagesordnungen der Karlsruher Gremien. Neue
        Tagesordnungspunkte erscheinen, sobald sie veröffentlicht wurden.
        Vergangene Sitzungen stehen im <a href={archiveUrl}>Archiv</a> ({
          pastMeetings.length
        } Sitzungen).
      </p>
    </div>

    {
      meetings.length > 0 ? (
        <>
          <MeetingFilters
            filterOptions={meetingFilterOptions}
            meetingCount={meetings.length}
          />
          <MeetingList
            meetings={meetings}
            filterValuesById={meetingFilterValuesById}
          />
          <p class="no-results" data-meeting-no-results hidden>
            Keine Sitzungen für die gewählten Filter gefunden.
          </p>
        </>
      ) : (
        <p class="empty">
          Derzeit sind keine kommenden Sitzungen verfügbar —{" "}
          <a href={archiveUrl}>vergangene Sitzungen im Archiv</a>.
        </p>
      )
    }
  </PageContainer>
</Layout>

<style>
  .meetings-page {
    max-width: 1000px;
  }

  .page-intro {
    margin: 0 auto 20px;
    color: var(--color-text-muted);
  }

  .page-intro p {
    margin: 0;
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
  }

  .no-results {
    margin: 24px 0;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
