---
import Layout from "../../layouts/Layout.astro";
import PaperListPage from "../../components/PaperListPage.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  getAvailablePaperSubmitters,
  loadPaperSubmitters,
  loadPapers,
} from "../../shared/data";
import { loadPaperFilterModel } from "../../shared/paper-filters";
import { getOParlEntityId } from "../../shared/utils";

export async function getStaticPaths() {
  const submitters = await getAvailablePaperSubmitters();
  return submitters.map((submitter) => ({
    params: { name: submitter.id },
    props: { submitterId: submitter.id, submitterName: submitter.name },
  }));
}

const { submitterId, submitterName } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const [allPapers, submitterIndex] = await Promise.all([
  loadPapers(),
  loadPaperSubmitters(),
]);

const papersBySubmitter = allPapers.filter((paper) => {
  const recordId = getOParlEntityId(paper.id);
  return recordId && submitterIndex.papers[recordId]?.includes(submitterId);
});

const { papers, valuesById, options } =
  await loadPaperFilterModel(papersBySubmitter);
---

<Layout
  title={submitterName}
  description={`Alle ${papers.length} Vorlagen und Anträge von ${submitterName} im Karlsruher Gemeinderat, nach Jahr und Status filterbar.`}
  navigationSection="submitters"
>
  <PaperListPage
    title={submitterName}
    papers={papers}
    filterValuesById={valuesById}
    filterOptions={options}
  >
    <div slot="intro">
      <Breadcrumbs
        items={[
          { label: "Fraktionen", href: `${baseUrl}fraktionen` },
          { label: submitterName },
        ]}
      />
      <p class="subtitle">{papers.length} Vorlagen</p>
    </div>
  </PaperListPage>
</Layout>

<style>
  .subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
</style>
