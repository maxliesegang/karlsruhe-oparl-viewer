{
  "name": "karlsruhe-oparl-viewer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/ensure-pagefind-index.mjs",
    "dev": "astro dev",
    "data:setup": "node scripts/setup-local-data.mjs",
    "prestart": "node scripts/ensure-pagefind-index.mjs",
    "start": "astro dev",
    "build": "astro build",
    "build:quick": "SKIP_PAGEFIND=1 astro build",
    "build:quiet": "node scripts/build-quiet.mjs",
    "build:quick:quiet": "SKIP_PAGEFIND=1 node scripts/build-quiet.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "npx prettier . --write"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  }
